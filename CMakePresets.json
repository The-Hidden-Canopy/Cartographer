{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Cartographer default",
      "description": "Headless C++23 build with tests and CLI enabled",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CARTO_BUILD_TESTS": "ON",
        "CARTO_BUILD_BENCHMARKS": "OFF",
        "CARTO_BUILD_CLI": "ON",
        "CARTO_BUILD_DEVICE_CPU": "ON",
        "CARTO_BUILD_PRIVATE_INTEGRATIONS": "OFF",
        "CARTO_PRIVATE_SOURCE_ROOT": "",
        "CARTO_BUILD_GMIB_GRAPHICS": "OFF",
        "CARTO_BUILD_GMIB_GAME": "OFF",
        "CARTO_GMIB_ROOT": "",
        "CARTO_ENABLE_VULKAN": "OFF",
        "CARTO_ENABLE_D3D12": "OFF",
        "CARTO_BUILD_D3D12_DESKTOP": "OFF",
        "CARTO_BUILD_DESKTOP": "OFF"
      }
    },
    {
      "name": "headless-release",
      "displayName": "Cartographer headless release",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/headless-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "benchmark-release",
      "displayName": "Cartographer public geometry benchmarks",
      "inherits": "headless-release",
      "binaryDir": "${sourceDir}/build/benchmarks",
      "cacheVariables": {
        "CARTO_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "sdk-shared-release",
      "displayName": "Cartographer public shared SDK",
      "inherits": "headless-release",
      "binaryDir": "${sourceDir}/build/sdk-shared-release",
      "cacheVariables": {
        "CARTO_BUILD_SDK_SHARED": "ON"
      }
    },
    {
      "name": "vulkan-headless-release",
      "displayName": "Cartographer Vulkan headless acceptance",
      "inherits": "headless-release",
      "binaryDir": "${sourceDir}/build/vulkan-headless-release",
      "cacheVariables": {
        "CARTO_ENABLE_VULKAN": "ON"
      }
    },
    {
      "name": "d3d12-headless-release",
      "displayName": "Cartographer D3D12 headless acceptance",
      "inherits": "headless-release",
      "binaryDir": "${sourceDir}/build/d3d12-headless-release",
      "cacheVariables": {
        "CARTO_ENABLE_D3D12": "ON"
      }
    },
    {
      "name": "d3d12-desktop-compile",
      "displayName": "Cartographer native D3D12 desktop compile",
      "inherits": "d3d12-headless-release",
      "binaryDir": "${sourceDir}/build/d3d12-desktop-compile",
      "cacheVariables": {
        "CARTO_BUILD_D3D12_DESKTOP": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "headless-release",
      "configurePreset": "headless-release"
    },
    {
      "name": "benchmark-release",
      "configurePreset": "benchmark-release"
    },
    {
      "name": "sdk-shared-release",
      "configurePreset": "sdk-shared-release"
    },
    {
      "name": "vulkan-headless-release",
      "configurePreset": "vulkan-headless-release"
    },
    {
      "name": "d3d12-headless-release",
      "configurePreset": "d3d12-headless-release"
    },
    {
      "name": "d3d12-desktop-compile",
      "configurePreset": "d3d12-desktop-compile"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "headless-release",
      "configurePreset": "headless-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "benchmark-release",
      "configurePreset": "benchmark-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vulkan-headless-release",
      "configurePreset": "vulkan-headless-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "d3d12-headless-release",
      "configurePreset": "d3d12-headless-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
