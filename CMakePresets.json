{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Cartographer default",
      "description": "Headless C++23 build with tests and CLI enabled",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CARTO_BUILD_TESTS": "ON",
        "CARTO_BUILD_CLI": "ON",
        "CARTO_BUILD_PRIVATE_INTEGRATIONS": "OFF",
        "CARTO_BUILD_GMIB_GRAPHICS": "OFF",
        "CARTO_BUILD_GMIB_GAME": "OFF",
        "CARTO_ENABLE_VULKAN": "OFF",
        "CARTO_BUILD_DESKTOP": "OFF"
      }
    },
    {
      "name": "headless-release",
      "displayName": "Cartographer headless release",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/headless-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "kernel-bench-release",
      "displayName": "Cartographer native kernel benchmark",
      "inherits": "headless-release",
      "binaryDir": "${sourceDir}/build/kernel-bench",
      "cacheVariables": {
        "CARTO_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "vulkan-headless-release",
      "displayName": "Cartographer Vulkan headless acceptance",
      "inherits": "headless-release",
      "binaryDir": "${sourceDir}/build/vulkan-headless-release",
      "cacheVariables": {
        "CARTO_ENABLE_VULKAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "headless-release",
      "configurePreset": "headless-release"
    },
    {
      "name": "kernel-bench-release",
      "configurePreset": "kernel-bench-release"
    },
    {
      "name": "vulkan-headless-release",
      "configurePreset": "vulkan-headless-release"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "headless-release",
      "configurePreset": "headless-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "kernel-bench-release",
      "configurePreset": "kernel-bench-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vulkan-headless-release",
      "configurePreset": "vulkan-headless-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
