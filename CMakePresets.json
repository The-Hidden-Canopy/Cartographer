{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Cartographer default",
      "description": "Headless C++23 build with tests and CLI enabled",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CARTO_BUILD_TESTS": "ON",
        "CARTO_BUILD_CLI": "ON",
        "CARTO_ENABLE_VULKAN": "OFF",
        "CARTO_BUILD_DESKTOP": "OFF"
      }
    },
    {
      "name": "headless-release",
      "displayName": "Cartographer headless release",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/headless-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "headless-release",
      "configurePreset": "headless-release"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "headless-release",
      "configurePreset": "headless-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

