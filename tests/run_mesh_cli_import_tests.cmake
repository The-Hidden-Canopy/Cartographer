if(NOT DEFINED CARTO_CLI OR NOT DEFINED CARTO_FIXTURE OR NOT DEFINED CARTO_BINARY_DIR)
    message(FATAL_ERROR "CLI, fixture, and binary directory are required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(root "${CARTO_BINARY_DIR}/mesh import cli ${nonce}")
file(MAKE_DIRECTORY "${root}")

function(run_success expected)
    execute_process(COMMAND ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT result EQUAL 0 OR NOT stdout MATCHES "${expected}")
        message(FATAL_ERROR "Command failed (${expected}): ${ARGN}\n${stdout}${stderr}")
    endif()
endfunction()
function(run_refused)
    execute_process(COMMAND ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(result EQUAL 0 OR NOT stderr MATCHES "create-only save refuses")
        message(FATAL_ERROR "Import did not refuse occupied target: ${ARGN}\n${stdout}${stderr}")
    endif()
endfunction()

run_success("" "${CARTO_FIXTURE}" create "${root}/fixture.carto")
foreach(format IN ITEMS obj ply stl)
    set(source "${root}/source.${format}")
    set(project "${root}/imported-${format}.carto")
    run_success("exported" "${CARTO_CLI}" "export-${format}" "${root}/fixture.carto" "${source}")
    file(SHA256 "${source}" source_before)
    run_success("journaled=true" "${CARTO_CLI}" "import-${format}" "${source}" "${project}")
    run_success("objects=1 meshes=1" "${CARTO_CLI}" validate "${project}")
    run_success("exported" "${CARTO_CLI}" "export-${format}" "${project}" "${root}/reopened.${format}")
    file(SHA256 "${project}" project_before)
    file(SHA256 "${project}.journal" journal_before)
    run_refused("${CARTO_CLI}" "import-${format}" "${source}" "${project}")
    file(SHA256 "${project}" project_after)
    file(SHA256 "${project}.journal" journal_after)
    if(NOT project_before STREQUAL project_after OR NOT journal_before STREQUAL journal_after)
        message(FATAL_ERROR "${format} reimport damaged the existing project or journal")
    endif()

    # A valid saved document with no application journal was previously overwritten.
    set(unjournaled "${root}/unjournaled-${format}.carto")
    configure_file("${root}/fixture.carto" "${unjournaled}" COPYONLY)
    file(SHA256 "${unjournaled}" unjournaled_before)
    run_refused("${CARTO_CLI}" "import-${format}" "${source}" "${unjournaled}")
    file(SHA256 "${unjournaled}" unjournaled_after)
    if(NOT unjournaled_before STREQUAL unjournaled_after OR EXISTS "${unjournaled}.journal")
        message(FATAL_ERROR "${format} import replaced an unjournaled project")
    endif()

    # Even an empty orphan journal is someone else's recovery target.
    set(orphan "${root}/orphan-${format}.carto")
    file(WRITE "${orphan}.journal" "")
    run_refused("${CARTO_CLI}" "import-${format}" "${source}" "${orphan}")
    file(SIZE "${orphan}.journal" orphan_bytes)
    if(EXISTS "${orphan}" OR NOT orphan_bytes EQUAL 0)
        message(FATAL_ERROR "${format} import adopted an existing orphan journal")
    endif()

    run_refused("${CARTO_CLI}" "import-${format}" "${source}" "${source}")
    file(SHA256 "${source}" source_after)
    if(NOT source_before STREQUAL source_after OR EXISTS "${source}.journal")
        message(FATAL_ERROR "${format} import modified its input when used as the output path")
    endif()
    if(format STREQUAL "obj")
        file(WRITE "${root}/invalid.${format}" "v invalid 0 0\n")
    else()
        file(WRITE "${root}/invalid.${format}" "not a valid mesh\n")
    endif()
    execute_process(COMMAND "${CARTO_CLI}" "import-${format}" "${root}/invalid.${format}" "${root}/invalid-${format}.carto"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(result EQUAL 0 OR EXISTS "${root}/invalid-${format}.carto" OR EXISTS "${root}/invalid-${format}.carto.journal")
        message(FATAL_ERROR "${format} parse failure published a partial project: ${stdout}${stderr}")
    endif()
endforeach()
message(STATUS "OBJ/PLY/STL CLI round trips and existing project/journal/source protection passed")
