if(NOT DEFINED CARTO_CLI OR NOT DEFINED CARTO_FIXTURE OR NOT DEFINED CARTO_BINARY_DIR)
    message(FATAL_ERROR "CLI, fixture, and binary directory are required")
endif()

string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
# Spaces exercise the public CLI argument boundary as well as source readers.
set(root "${CARTO_BINARY_DIR}/preparation cli ${nonce}")
file(MAKE_DIRECTORY "${root}")
set(project "${root}/source.carto")
set(profile "${root}/portable.carto-prep")
set(output "${root}/prepared")

function(run_success expected)
    execute_process(COMMAND ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT result EQUAL 0 OR NOT stdout MATCHES "${expected}")
        message(FATAL_ERROR "Command failed its success contract (${expected}): ${ARGN}\n${stdout}${stderr}")
    endif()
    set(last_stdout "${stdout}" PARENT_SCOPE)
endfunction()

function(run_failure)
    execute_process(COMMAND ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(result EQUAL 0 OR NOT stderr MATCHES "error.|diagnostic code=")
        message(FATAL_ERROR "Command did not fail with a diagnostic: ${ARGN}\n${stdout}${stderr}")
    endif()
    # Every rejected request must preserve both the source and last-valid selector.
    file(SHA256 "${project}" source_after)
    file(SHA256 "${output}/current" selector_after)
    if(NOT source_before STREQUAL source_after OR NOT selector_before STREQUAL selector_after)
        message(FATAL_ERROR "Rejected preparation changed its source or last-valid selector")
    endif()
endfunction()

run_success("" "${CARTO_FIXTURE}" create-scene "${project}")
file(SHA256 "${project}" source_before)
run_success("preparation_profile_written" "${CARTO_CLI}" write-default-preparation-profile "${profile}")
string(REGEX MATCH "digest=([0-9a-f]+)" digest_match "${last_stdout}")
set(profile_digest "${CMAKE_MATCH_1}")
string(LENGTH "${profile_digest}" digest_length)
if(NOT digest_length EQUAL 64)
    message(FATAL_ERROR "Written profile did not report its canonical SHA-256 identity")
endif()
run_success("digest=${profile_digest}" "${CARTO_CLI}" inspect-preparation-profile "${profile}")
file(SHA256 "${profile}" profile_before)
run_success("assets=2 nodes=4.*reused=false" "${CARTO_CLI}" prepare "${project}" "${output}" --profile "${profile}" scene)
string(REGEX MATCH "source_revision=([0-9]+)" source_revision_match "${last_stdout}")
set(initial_source_revision "${CMAKE_MATCH_1}")
if(NOT last_stdout MATCHES "profile_digest=${profile_digest}")
    message(FATAL_ERROR "Preparation did not bind the saved profile digest")
endif()
file(SHA256 "${output}/current" selector_before)
run_success("assets=2 nodes=4.*reused=true" "${CARTO_CLI}" prepare "${project}" "${output}" scene)
file(SHA256 "${output}/current" selector_repeated)
if(NOT selector_before STREQUAL selector_repeated)
    message(FATAL_ERROR "Default and saved portable profiles did not reuse one exact revision")
endif()
run_success("assets=2 nodes=4" "${CARTO_CLI}" inspect-prepared "${output}")

# Exact asset IDs, ancestor closure, assembly descendants, and canonical selection.
run_success("assets=1 nodes=0" "${CARTO_CLI}" prepare "${project}" "${root}/asset" asset 2)
run_success("product identity=mesh.2.render" "${CARTO_CLI}" inspect-prepared "${root}/asset")
if(last_stdout MATCHES "product identity=mesh.1.render")
    message(FATAL_ERROR "Explicit second-asset scope also included the first asset")
endif()
run_success("assets=2 nodes=3" "${CARTO_CLI}" prepare "${project}" "${root}/assembly" assembly 2)
run_success("assets=2 nodes=3" "${CARTO_CLI}" prepare "${project}" "${root}/selection" selection 3 2)
file(SHA256 "${root}/selection/current" selection_before)
run_success("reused=true" "${CARTO_CLI}" prepare "${project}" "${root}/selection" selection 2 3)
file(SHA256 "${root}/selection/current" selection_after)
if(NOT selection_before STREQUAL selection_after)
    message(FATAL_ERROR "Selection ordering changed prepared identity")
endif()

run_failure("${CARTO_CLI}" write-default-preparation-profile "${profile}")
file(SHA256 "${profile}" profile_after)
if(NOT profile_before STREQUAL profile_after)
    message(FATAL_ERROR "Profile writer overwrote an existing profile")
endif()
file(READ "${profile}" profile_text)
file(WRITE "${root}/invalid.carto-prep" "${profile_text}TRAILING\n")
run_failure("${CARTO_CLI}" inspect-preparation-profile "${root}/invalid.carto-prep")
run_failure("${CARTO_CLI}" prepare "${project}" "${output}" --profile "${root}/invalid.carto-prep" scene)
run_failure("${CARTO_CLI}" prepare "${project}" "${output}" --profile "${profile}")
run_failure("${CARTO_CLI}" prepare "${project}" "${output}" scene extra)
run_failure("${CARTO_CLI}" prepare "${project}" "${output}" selection)
run_failure("${CARTO_CLI}" prepare "${project}" "${output}" selection 2 2)
run_failure("${CARTO_CLI}" prepare "${project}" "${output}" selection 999)
foreach(invalid_id IN ITEMS 0 -1 1junk 18446744073709551616 999)
    run_failure("${CARTO_CLI}" prepare "${project}" "${output}" asset "${invalid_id}")
endforeach()
run_failure("${CARTO_CLI}" prepare "${project}" "${root}/invalid-new-root" asset 999)
if(EXISTS "${root}/invalid-new-root")
    message(FATAL_ERROR "Invalid initial scope created a partial publication root")
endif()

# An unrelated project's valid geometry cannot take over the selected namespace.
run_success("" "${CARTO_FIXTURE}" create-scene "${root}/other.carto")
run_failure("${CARTO_CLI}" prepare "${root}/other.carto" "${output}" scene)

# A later source revision publishes, but a previously saved revision cannot roll it back.
configure_file("${project}" "${root}/older.carto" COPYONLY)
run_success("" "${CARTO_FIXTURE}" mutate "${project}")
file(SHA256 "${project}" source_before)
run_success("reused=false" "${CARTO_CLI}" prepare "${project}" "${output}" scene)
string(REGEX MATCH "source_revision=([0-9]+)" source_revision_match "${last_stdout}")
set(new_source_revision "${CMAKE_MATCH_1}")
if(NOT new_source_revision GREATER initial_source_revision)
    message(FATAL_ERROR "Mutated fixture did not advance the project revision")
endif()
file(SHA256 "${output}/current" newer_selector)
if(selector_before STREQUAL newer_selector)
    message(FATAL_ERROR "Changed source revision did not create a new prepared identity")
endif()
set(selector_before "${newer_selector}")
run_failure("${CARTO_CLI}" prepare "${root}/older.carto" "${output}" scene)
run_success("source_revision=${new_source_revision}" "${CARTO_CLI}" inspect-prepared "${output}")

# Relocated products remain inspectable while the original source is absent.
file(COPY "${output}/" DESTINATION "${root}/relocated")
file(RENAME "${project}" "${root}/source-away.carto")
run_success("source_revision=${new_source_revision}.*assets=2 nodes=4" "${CARTO_CLI}" inspect-prepared "${root}/relocated")
file(RENAME "${root}/source-away.carto" "${project}")

# Readers detect modified payloads, without damaging the original publication.
file(GLOB_RECURSE relocated_products "${root}/relocated/revisions/*/products/*.bin")
list(LENGTH relocated_products product_count)
if(product_count LESS 1)
    message(FATAL_ERROR "Preparation fixture did not produce an independently inspectable payload")
endif()
foreach(product IN LISTS relocated_products)
    file(APPEND "${product}" "tampered")
endforeach()
run_failure("${CARTO_CLI}" inspect-prepared "${root}/relocated")
run_success("source_revision=${new_source_revision}.*assets=2 nodes=4" "${CARTO_CLI}" inspect-prepared "${output}")
file(SHA256 "${project}" source_after)
if(NOT source_before STREQUAL source_after)
    message(FATAL_ERROR "Preparation or inspection mutated the final source")
endif()
message(STATUS "Preparation CLI profiles, scopes, replay, lineage, relocation and failure preservation passed")
