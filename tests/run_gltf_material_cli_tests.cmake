if(NOT DEFINED CARTO_CLI OR NOT DEFINED CARTO_FIXTURE OR NOT DEFINED CARTO_BINARY_DIR)
    message(FATAL_ERROR "CLI, material fixture, and binary directory are required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(work_root "${CARTO_BINARY_DIR}/material_cli_${nonce}")
execute_process(COMMAND "${CARTO_FIXTURE}" --fixture "${work_root}"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Material fixture failed: ${stdout}${stderr}")
endif()
set(project "${work_root}/source.carto")
file(SHA256 "${project}" source_before)
foreach(format IN ITEMS gltf glb)
    set(output "${work_root}/cli.${format}")
    execute_process(COMMAND "${CARTO_CLI}" "export-${format}" "${project}" "${output}"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Textured ${format} CLI export failed: ${stdout}${stderr}")
    endif()
    if(NOT stdout MATCHES "materials=[1-9][0-9]*" OR
       NOT stdout MATCHES "images=[1-9][0-9]*" OR NOT stdout MATCHES "warning:")
        message(FATAL_ERROR "CLI export hid material/image counts or limitations: ${stdout}")
    endif()
    file(SHA256 "${output}" actual)
    file(SHA256 "${work_root}/material.${format}" expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "CLI ${format} does not preserve complete API material/pixel payload")
    endif()
endforeach()
file(SHA256 "${project}" source_after)
if(NOT source_before STREQUAL source_after)
    message(FATAL_ERROR "Material CLI export changed source authoring project")
endif()
# Corrupt only this test-owned store. Replacement must fail before changing either good output.
file(GLOB_RECURSE blobs LIST_DIRECTORIES FALSE "${work_root}/.carto-assets/source-blobs/*")
list(LENGTH blobs count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected one digest-addressed fixture blob")
endif()
list(GET blobs 0 blob)
file(WRITE "${blob}" "corrupt-test-owned-pixels")
foreach(format IN ITEMS gltf glb)
    set(output "${work_root}/cli.${format}")
    file(SHA256 "${output}" before)
    execute_process(COMMAND "${CARTO_CLI}" "export-${format}" "${project}" "${output}"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(result EQUAL 0)
        message(FATAL_ERROR "Corrupt source pixels were silently exported")
    endif()
    file(SHA256 "${output}" after)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "Failed CLI material export damaged the prior good output")
    endif()
endforeach()
message(STATUS "PASS textured CLI GLTF/GLB exact material+image parity, saved-project hydration, source invariance and corrupt-blob failure atomicity: ${work_root}")
set(bake_root "${work_root}/graph_bake")
execute_process(COMMAND "${CARTO_FIXTURE}" --bake-fixture "${bake_root}"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Graph bake fixture failed: ${stdout}${stderr}")
endif()
foreach(format IN ITEMS gltf glb)
    set(output "${bake_root}/cli.${format}")
    file(WRITE "${output}" "prior-good-output")
    execute_process(COMMAND "${CARTO_CLI}" "export-${format}" "${bake_root}/baked.carto" "${output}"
        RESULT_VARIABLE result)
    file(READ "${output}" retained)
    if(result EQUAL 0 OR NOT retained STREQUAL "prior-good-output")
        message(FATAL_ERROR "Strict CLI export silently baked or damaged prior output")
    endif()
    execute_process(COMMAND "${CARTO_CLI}" "export-${format}" "${bake_root}/baked.carto" "${output}" 16
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT result EQUAL 0 OR NOT stdout MATCHES "Explicit material graph bake")
        message(FATAL_ERROR "Explicit CLI bake failed or hid approximation: ${stdout}${stderr}")
    endif()
    file(SHA256 "${output}" actual)
    file(SHA256 "${bake_root}/baked.${format}" expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "CLI graph bake differs from explicit API bake")
    endif()
endforeach()
# Exercise the upper bound through the CLI parser as well as the API. The
# fixture's two regions share one material, so the 1M aggregate budget fits.
set(high_project "${bake_root}/high-resolution.carto")
set(high_output "${bake_root}/cli-high-resolution.gltf")
file(SHA256 "${high_project}" high_source_before)
execute_process(COMMAND "${CARTO_CLI}" export-gltf "${high_project}" "${high_output}" 1024
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result EQUAL 0 OR NOT stdout MATCHES "1024x1024 RGBA8")
    message(FATAL_ERROR "High-resolution CLI bake failed or hid approximation: ${stdout}${stderr}")
endif()
file(SHA256 "${high_output}" high_actual)
file(SHA256 "${bake_root}/high-resolution.gltf" high_expected)
if(NOT high_actual STREQUAL high_expected)
    message(FATAL_ERROR "High-resolution CLI graph bake differs from API bake")
endif()
execute_process(COMMAND "${CARTO_CLI}" export-gltf "${high_project}" "${high_output}" 2048
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(result EQUAL 0 OR NOT stderr MATCHES "4[.][.]1024")
    message(FATAL_ERROR "CLI accepted an excessive graph bake resolution: ${stdout}${stderr}")
endif()
file(SHA256 "${high_output}" high_after)
file(SHA256 "${high_project}" high_source_after)
if(NOT high_actual STREQUAL high_after OR NOT high_source_before STREQUAL high_source_after)
    message(FATAL_ERROR "High-resolution CLI bake changed source or failed to preserve prior output")
endif()
